{
  "name": "docker-node-app",
  "version": "3.0.1",
  "description": "Node.js on Docker",
  "repository": "https://github.com/jonfairbanks/docker-node-app.git",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch --inspect=0.0.0.0:9229 index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --test",
    "test:watch": "node --test --watch"
  },
  "engines": {
    "node": ">=26 <27",
    "npm": ">=10"
  },
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "dayjs": "^1.11.23",
    "ejs": "^7.0.2",
    "express": "^5.3.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "supertest": "^7.3.1"
  }
}
